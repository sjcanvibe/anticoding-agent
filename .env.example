# AntiCoding Agent Configuration Template
# Copy this file to .env (automatically loaded on startup) or export in your shell.
# Standard OPENAI_BASE_URL, OPENAI_API_KEY, and OPENAI_MODEL variables are also supported.

# ------------------------------------------------------------------------------
# 1. API Endpoint & Authentication (Any OpenAI-compatible /v1 API)
# ------------------------------------------------------------------------------
# Examples:
#   Local llama.cpp : http://127.0.0.1:8080/v1 (or http://127.0.0.1:8081/v1)
#   Local Ollama    : http://127.0.0.1:11434/v1
#   Local vLLM      : http://127.0.0.1:8000/v1
#   OpenAI Official : https://api.openai.com/v1
#   DeepSeek API    : https://api.deepseek.com/v1
#   OpenRouter      : https://openrouter.ai/api/v1
ANTICODING_API_BASE=http://127.0.0.1:8081/v1

# API Key (use your sk-... key for cloud providers, or leave default for local servers)
ANTICODING_API_KEY=sk-no-key-required

# Model Name (e.g., Qwen3-Coder-Next-Q8_0, qwen2.5-coder:32b, gpt-4.1, deepseek-chat)
ANTICODING_MODEL=Qwen3-Coder-Next-Q8_0

# ------------------------------------------------------------------------------
# 2. Context Window & Execution Controls
# ------------------------------------------------------------------------------
# Context window size of the target model (e.g. 131072 for 128k context)
ANTICODING_CTX_SIZE=131072

# Maximum context tokens allocated before rolling compaction triggers
ANTICODING_MAX_TOKENS=98304

# Number of recent conversation messages preserved during compaction
ANTICODING_RECENT_MSGS=14

# Confirmation mode before shell commands and file edits: 'auto' or 'ask'
ANTICODING_CONFIRM=auto
