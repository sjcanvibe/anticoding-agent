# AntiCoding Agent Configuration Template
# Copy this file to .env (automatically loaded on startup) or export in your shell

# OpenAI-compatible API base (default: local llama.cpp / llama.service)
ANTICODING_API_BASE=http://127.0.0.1:8081/v1

# API Key (leave default if local server requires no authentication)
ANTICODING_API_KEY=sk-no-key-required

# Model Name as registered on the inference backend
ANTICODING_MODEL=Qwen3-Coder-Next-Q8_0

# Context window size of the local server (e.g. 131072 for 128k context)
ANTICODING_CTX_SIZE=131072

# Maximum context tokens allocated before rolling compaction triggers
ANTICODING_MAX_TOKENS=98304

# Number of recent conversation messages preserved during compaction
ANTICODING_RECENT_MSGS=14
